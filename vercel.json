{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://lp.tajima2chome.com/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "https://lp.tajima2chome.com/",
      "permanent": false
    }
  ]
}